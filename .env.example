# Obtain at https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Obtain from your OpenAI API dashboard
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Test against your own second account FIRST; replace only when ready.
MANAGER_USERNAME=
# Never set to 1 until you have tested and explicitly intend to contact manager.
LIVE_SEND=0
# Optional: name supplied by the user, otherwise the agent must ask for it if required.
BOOKING_NAME=
# Optional contact number if manager requires one
BOOKING_PHONE=
# Maximum AI turns / outbound messages
MAX_MESSAGES=12
