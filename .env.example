# Telegram API credentials: https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# AI backend used in the demo: local OmniRoute -> Gemini
AI_PROVIDER=omniroute
AI_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=dummy-key
AI_MODEL=gemini/gemini-3.1-flash-lite

# Alternative direct OpenAI backend (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Use your own second Telegram account when testing
MANAGER_USERNAME=
TEST_MODE=1
LIVE_SEND=0
BOOKING_NAME=
BOOKING_PHONE=
MAX_MESSAGES=12
